    "keywords": ["llm", "hallucination", "multi-agent", "consensus", "ai-safety", "verification"],
    "require": {
        "php": ">=8.1",
        "ext-curl": "*",
        "ext-json": "*",
        "ext-mbstring": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0"
    },
    "autoload": {
        "psr-4": {
            "NHM\\": "src/"
        }
